{
  "name": "webeng-projekt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "scripts": {
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "backend:build": "nx build backend",
    "backend:start": "node dist/apps/backend/main.js",
    "backend:start:dev": "nx build backend && node dist/apps/backend/main.js",
    "backend:start:debug": "nx build backend && node --inspect dist/apps/backend/main.js",
    "backend:test": "nx test backend",
    "backend:test:e2e": "nx e2e backend",
    "backend:lint": "nx lint backend",
    "backend:format": "prettier --write \"apps/backend/src/**/*.ts\" \"apps/backend/test/**/*.ts\"",
    "frontend:build": "nx build frontend",
    "frontend:start": "nx serve frontend",
    "frontend:test": "nx test frontend",
    "frontend:lint": "nx lint frontend",
    "frontend:format": "prettier --write \"apps/frontend/src/**/*.ts\" \"apps/frontend/src/**/*.html\" \"apps/frontend/src/**/*.scss\"",
    "format": "prettier --write \"apps/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,html,scss,json}\"",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "build": "nx run-many --target=build --all",
    "typeorm": "ts-node --transpile-only --project apps/backend/tsconfig.app.json node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d apps/backend/src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d apps/backend/src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d apps/backend/src/database/data-source.ts"
  },
  "dependencies": {
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-browser-dynamic": "21.2.9",
    "@angular/router": "21.2.9",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.29",
    "zone.js": "^0.16.2"
  },
  "overrides": {
    "axios": "^1.16.1",
    "yaml": "^2.9.0",
    "nx": {
      "brace-expansion": "^5.0.6",
      "follow-redirects": "^1.16.0"
    },
    "webpack-dev-server": "^5.2.4",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.9",
    "@angular/build": "21.2.9",
    "@angular/cli": "21.2.10",
    "@angular/compiler-cli": "21.2.9",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@nx/angular": "22.7.1",
    "@nx/eslint": "22.7.1",
    "@nx/jest": "22.7.1",
    "@nx/nest": "22.7.1",
    "@nx/node": "22.7.1",
    "@nx/workspace": "22.7.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "angular-eslint": "21.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^16.1.5",
    "jsdom": "^28.0.0",
    "nx": "22.7.1",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.2"
  }
}
